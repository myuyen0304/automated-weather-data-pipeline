OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEZONE=Asia/Ho_Chi_Minh

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=weather_db
DB_USER=postgres
DB_PASSWORD=postgres

# MinIO root credentials (cung la access key/secret cho boto3). Password >= 8 ky tu.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Bat upload cho host scripts. Airflow tu bat rieng trong docker-compose.airflow.yml.
OBJECT_STORAGE_ENABLED=false
# Neu false, raw JSON khong ghi xuong data/raw local ma put thang len MinIO/S3.
# Chi set false khi OBJECT_STORAGE_ENABLED=true.
RAW_LOCAL_WRITE_ENABLED=true
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_BUCKET=weather-pipeline
S3_REGION=us-east-1
S3_RAW_PREFIX=raw/open-meteo
S3_CLEANED_PREFIX=cleaned
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
